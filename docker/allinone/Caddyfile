{
	admin off
	# A plataforma (Cloud Run / Render) termina o TLS antes de chegar aqui.
	auto_https off
}

:{$PORT:8080} {
	encode zstd gzip

	# Spring Boot no mesmo container, porta interna 8081.
	handle /api/* {
		reverse_proxy 127.0.0.1:8081
	}

	# SPA. O vue-router usa createWebHistory, entao rota desconhecida
	# cai no index.html em vez de 404.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

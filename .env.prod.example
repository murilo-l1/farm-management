# Copie para .env e preencha com valores REAIS. O .env nunca vai para o git.
#   cp .env.prod.example .env

# Endereco do site para o Caddy.
#   PRODUCAO: apenas o host, sem esquema e SEM PORTA -> o Caddy escuta 80/443
#             e emite o certificado Let's Encrypt sozinho.
#             Ex: SITE_ADDRESS=agrogestao.duckdns.org
#   LOCAL:    use ":80" -> catch-all em HTTP puro, sem TLS.
#             Nao coloque porta no SITE_ADDRESS: quem decide a porta publicada
#             e o HTTP_PORT abaixo. O Caddy sempre escuta 80 dentro do container.
SITE_ADDRESS=

# Origem exata usada no CORS do Spring (SecurityConfig usa match exato, sem wildcard).
#   PRODUCAO: https://agrogestao.duckdns.org
#   LOCAL:    http://localhost:8090
CORS_ORIGINS=

# Banco. Use uma senha nova e forte, diferente da usada no ambiente local.
#   openssl rand -base64 24
POSTGRES_DB=farmdb
POSTGRES_USER=farmadmin
POSTGRES_PASSWORD=

# Segredo do JWT. PRECISA ser Base64 valido (e decodificado no boot do Spring).
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# Portas publicadas no host.
#   PRODUCAO: 80 e 443.
#   LOCAL:    8090 e 8443, para nao conflitar com nada no Windows.
HTTP_PORT=80
HTTPS_PORT=443
